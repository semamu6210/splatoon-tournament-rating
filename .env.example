# PostgreSQL connection string. Use a local DB in development and a hosted PostgreSQL DB in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Auth.js secret. Generate a long random value per environment.
AUTH_SECRET=""

# Discord OAuth credentials from Discord Developer Portal.
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Public application URL.
# Development: http://localhost:3000
# Production: https://YOUR_DOMAIN
AUTH_URL="http://localhost:3000"

# Development/E2E only. Never enable on a public production URL.
ENABLE_TEST_AUTH="false"
